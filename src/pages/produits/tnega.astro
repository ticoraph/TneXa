---
import BaseLayout from '../../layouts/BaseLayout.astro';

const features = [
  ['Installé chez vous', 'La plateforme tourne dans votre environnement. Vos données n’en sortent pas.'],
  ['Réversible', 'Vous récupérez vos données et vos paramétrages. Aucun enfermement.'],
  ['Indépendant des LLM', 'Vous changez de modèle sans tout reconstruire.'],
  ['Traçable', 'Chaque décision d’un agent se retrouve et s’explique.'],
  ['Connecté par MCP', 'Vos agents utilisent vos outils, avec les droits que vous fixez.'],
];
const uses = ['Assistant documentaire', 'Copilote support', 'Interrogation de procédures', 'Recherche technique', 'Analyse contractuelle', 'Agents privés'];
---

<BaseLayout
  title="TneGa | aGenT — Plateforme IA"
  description="TneGa est la plateforme IA de TneXa : des agents installés dans votre environnement, traçables, indépendants des modèles de langage."
>
  <header class="content-hero container">
    <p class="eyebrow">Produit TneXa · 01</p>
    <p class="lockup" aria-label="TneGa, le mot aGenT lu à l’envers">
      <span>aGenT</span>
      <i aria-hidden="true">lu à l’envers</i>
      <strong>TneGa</strong>
    </p>
    <h1>Vos agents IA. Chez vous.</h1>
  </header>

  <section class="section container">
    <h2 class="visually-hidden">Ce que fait TneGa</h2>
    <ul class="feature-grid">
      {features.map(([title, text], index) => (
        <li>
          <span>0{index + 1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="dark-section">
    <div class="container modes">
      <div>
        <p class="eyebrow">Deux modes</p>
        <h2>Vous choisissez où tournent les modèles.</h2>
      </div>
      <ul>
        <li><h3>Privé hybride</h3><p>Plateforme privée. Modèles externes autorisés.</p></li>
        <li><h3>100 % local</h3><p>Sur votre GPU ou sur un GPU privé. Rien ne sort.</p></li>
      </ul>
    </div>
  </section>

  <section class="section container">
    <p class="eyebrow">Un socle</p>
    <h2>Une base, plusieurs offres.</h2>
    <ul class="chips uses">
      {uses.map((use) => <li>{use}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .lockup {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }

  .lockup span { color: #69817c; font-size: 1.1rem; font-weight: 750; letter-spacing: 0.13em; text-decoration: line-through; }
  .lockup i { color: #5d7772; font-size: 0.75rem; font-style: normal; font-weight: 700; text-transform: uppercase; }
  .lockup strong { flex: 0 0 100%; font-size: clamp(2.3rem, 1.8rem + 5vw, 4.3rem); letter-spacing: -0.07em; line-height: 1; }
  .content-hero h1 { max-width: 10ch; }

  .feature-grid {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature-grid li {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--white);
  }

  .feature-grid span { display: block; margin-bottom: 1rem; color: #4d6d67; font-size: 0.8rem; font-weight: 800; }
  .feature-grid h3 { margin-bottom: 0.4rem; }
  .feature-grid p { margin: 0; color: var(--ink-soft); }

  .dark-section { padding-block: clamp(3rem, 9vw, 7rem); color: var(--white); background: var(--ink); }
  .dark-section .eyebrow { color: rgba(255, 255, 255, 0.66); }
  .modes { display: grid; gap: 2rem; }
  .modes h2 { max-width: 14ch; }
  .modes ul { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .modes li { padding: 1.25rem; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: var(--radius-md); }
  .modes h3 { margin-bottom: 0.4rem; color: var(--lime); }
  .modes p { margin: 0; color: rgba(255, 255, 255, 0.72); }

  .uses { margin-top: 1.5rem; }
  .uses li { padding: 0.55rem 0.9rem; font-size: 0.95rem; }

  @media (min-width: 40rem) {
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 56rem) {
    .feature-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .modes { grid-template-columns: 1fr 1fr; gap: 5rem; }
  }
</style>
