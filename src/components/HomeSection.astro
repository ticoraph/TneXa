---
import HomeArt from './HomeArt.astro';

// Un bloc de la page d'accueil : le titre et le paragraphe viennent du MDX (slot),
// l'illustration est décorative.
interface Props {
  art: 'orbit' | 'helix' | 'converge' | 'loop';
  tone?: 'light' | 'dark';
  /** Place l'illustration avant le texte sur grand écran. */
  flip?: boolean;
}

const { art, tone = 'light', flip = false } = Astro.props;
---

<section class="home-section container" data-tone={tone} data-flip={flip ? '' : undefined}>
  <div class="panel">
    <div class="home-text">
      <slot />
    </div>
    <div class="home-art" aria-hidden="true">
      <HomeArt name={art} />
    </div>
  </div>
</section>

<style>
  .home-section {
    padding-block: clamp(1.5rem, 5vw, 3.5rem);
  }

  .panel {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .home-section[data-tone='dark'] {
    --w-dim: rgba(255, 255, 255, 0.2);
    --w-on: var(--white);
  }

  .home-section[data-tone='dark'] .panel {
    padding: clamp(1.5rem, 6vw, 4.5rem) clamp(1.25rem, 5vw, 4rem);
    border-radius: var(--radius-lg);
    color: var(--white);
    background:
      radial-gradient(circle at 90% 8%, rgba(93, 224, 193, 0.28), transparent 18rem),
      radial-gradient(circle at 5% 100%, rgba(223, 255, 99, 0.12), transparent 16rem),
      var(--ink);
  }

  .home-text :global(h2) {
    margin-bottom: 1.25rem;
    font-size: clamp(1.9rem, 1.1rem + 3.8vw, 3.6rem);
  }

  .home-text :global(p) {
    max-width: 34rem;
    margin: 0;
    font-size: clamp(1.1rem, 1rem + 0.55vw, 1.35rem);
    line-height: 1.55;
  }

  /* Surlignage des passages en gras, une fois le paragraphe entièrement lu. */
  .home-text :global(strong) {
    padding-inline: 0.12em;
    margin-inline: -0.12em;
    background: linear-gradient(var(--lime), var(--lime)) 0 88% / 100% 0.42em no-repeat;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  :global(.js-motion) .home-text :global(strong) {
    background-size: 0% 0.42em;
    transition: background-size 900ms cubic-bezier(0.2, 0.7, 0.2, 1) 150ms;
  }

  :global(.js-motion) .home-text :global(p.done strong) {
    background-size: 100% 0.42em;
  }

  .home-section[data-tone='dark'] .home-text :global(strong) {
    color: var(--lime);
    background: none;
  }

  .home-section[data-tone='dark'] .home-text :global(strong .w.on) {
    color: var(--lime);
  }

  .home-art {
    width: min(100%, 20rem);
    aspect-ratio: 1;
    margin-inline: auto;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: rgba(255, 254, 249, 0.75);
    box-shadow: var(--shadow);
  }

  .home-section[data-tone='dark'] .home-art {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: none;
  }

  @media (min-width: 56rem) {
    .panel {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(2rem, 6vw, 6rem);
    }

    .home-section[data-flip] .panel {
      grid-template-columns: 0.9fr 1.1fr;
    }

    .home-section[data-flip] .home-art {
      order: -1;
    }

    .home-art {
      width: min(100%, 26rem);
      padding: 1.75rem;
    }
  }
</style>
