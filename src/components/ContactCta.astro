---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Un cas d’usage à transformer ?',
  text = 'Échangeons sur votre contexte, vos données et le résultat que vous cherchez à obtenir.',
} = Astro.props;
---

<section class="cta-shell" aria-labelledby="cta-title">
  <div>
    <p class="eyebrow">Prochaine étape</p>
    <h2 id="cta-title">{title}</h2>
    <p>{text}</p>
  </div>
  <a class="button button--light" href="/contact">Parler de votre projet <span aria-hidden="true">↗</span></a>
</section>

<style>
  .cta-shell {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
    max-width: none;
    margin-block: clamp(4rem, 8vw, 8rem) 0;
    padding: clamp(2rem, 5vw, 4.5rem);
    border-radius: var(--radius-lg);
    color: var(--white);
    background:
      radial-gradient(circle at 80% 20%, rgba(93, 224, 193, 0.35), transparent 16rem),
      var(--ink);
  }

  .cta-shell .eyebrow {
    color: rgba(255, 255, 255, 0.72);
  }

  h2 {
    max-width: 12ch;
    margin-bottom: 1rem;
    font-size: clamp(2.3rem, 5vw, 4.6rem);
  }

  p:not(.eyebrow) {
    max-width: 39rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
  }

  .button {
    flex: 0 0 auto;
  }

  @media (max-width: 720px) {
    .cta-shell {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
