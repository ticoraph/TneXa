---
import BaseLayout from './BaseLayout.astro';
import { siteConfig } from '../config';

// Gabarit commun des fiches Réalisations et R&D.
// Le corps MDX tient en un paragraphe de présentation. Le frontmatter fournit
// le tableau de données (`facts`), l'encart « IA » (`ia`), le site (`site`, car Astro réserve `url`) et les dépôts publics (`repos`).
interface Fact {
  label: string;
  value: string;
}

interface Repo {
  label: string;
  href: string;
}

const {
  title,
  description,
  eyebrow = 'Réalisation',
  intro,
  status,
  facts = [],
  ia,
  site,
  urlLabel,
  repos = [],
  back,
} = Astro.props.frontmatter;

// Fiche suivante de la rubrique, en boucle, pour passer d'une fiche à l'autre sans rouvrir le menu.
const section = siteConfig.navigation.find((item) => item.href === back?.href);
const siblings = section?.children ?? [];
const index = siblings.findIndex((child) => child.href === Astro.url.pathname);
const next = section?.nextLabel && siblings.length > 1 && index >= 0 ? siblings[(index + 1) % siblings.length] : undefined;
---

<BaseLayout title={title} description={description}>
  <div class="case container">
    <header class="case-head">
      <p class="eyebrow">{eyebrow}{status && ` · ${status}`}</p>
      <h1>{title}</h1>
      {intro && <p class="lede">{intro}</p>}
      {(site || repos.length > 0) && (
        <div class="case-links">
          {site && <a class="button" href={site} target="_blank" rel="noopener noreferrer">{urlLabel ?? 'Voir le site'} <span aria-hidden="true">↗</span><span class="visually-hidden"> (nouvel onglet)</span></a>}
          {repos.map((repo: Repo) => (
            <a class="text-link" href={repo.href} target="_blank" rel="noopener noreferrer">{repo.label} ↗<span class="visually-hidden"> (nouvel onglet)</span></a>
          ))}
        </div>
      )}
    </header>

    <div class="case-body">
      <article class="prose">
        <slot />
      </article>
      {facts.length > 0 && (
        <dl class="facts">
          {facts.map((fact: Fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <aside class="case-ia" aria-labelledby="case-ia-titre">
      <p class="case-ia-label" id="case-ia-titre">IA</p>
      {ia && <p class="case-ia-text">{ia}</p>}
    </aside>

    {back && (
      <nav class="case-nav" aria-label="Navigation entre les fiches">
        <a class="text-link" href={back.href}>← {back.label}</a>
        {next && (
          <a class="text-link case-next" href={next.href} rel="next" aria-label={`${section?.nextLabel} : ${next.label}`}>
            {next.label} →
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .case {
    display: grid;
    gap: 1.5rem;
    padding-block: 2rem 1.5rem;
  }

  .case-head h1 {
    max-width: 14ch;
  }

  .case-head .lede {
    margin: 1rem 0 0;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    align-items: center;
    margin-top: 1.25rem;
  }

  .case-links .button {
    width: 100%;
  }

  .case-body .prose p {
    margin: 0 0 1.25rem;
  }

  .facts {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .facts > div {
    display: grid;
    gap: 0.1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    color: #4d6d67;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0;
  }

  .case-ia {
    display: grid;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-md);
    color: var(--white);
    background: var(--ink);
  }

  .case-ia-label {
    justify-self: start;
    margin: 0;
    padding: 0.1rem 0.7rem;
    border-radius: 999px;
    color: var(--ink);
    background: var(--lime);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .case-ia-text {
    max-width: 60rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
  }

  .case-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.25rem;
  }

  @media (min-width: 40rem) {
    .case-links .button {
      width: auto;
    }
  }

  /* Bureau : présentation à gauche, données à droite, sans défilement. */
  @media (min-width: 64rem) {
    .case {
      grid-template-columns: 5fr 7fr;
      gap: 1.25rem 4rem;
      align-items: start;
      padding-block: 1.5rem 0.5rem;
    }

    .case-head h1 {
      font-size: clamp(2.5rem, 4vw, 3.5rem);
    }

    .case-body {
      padding-top: 0.5rem;
    }

    .case-body :global(.prose p) {
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .facts > div {
      grid-template-columns: 9rem 1fr;
      gap: 1rem;
      align-items: baseline;
      padding-block: 0.3rem;
      font-size: 0.9rem;
    }

    .case-ia,
    .case-nav {
      grid-column: 1 / -1;
    }

    .case-ia {
      grid-template-columns: auto 1fr;
      gap: 1.25rem;
      align-items: baseline;
      padding-block: 0.7rem;
    }
  }
</style>
