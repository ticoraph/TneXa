---
import BaseLayout from './BaseLayout.astro';
import HomeArt from '../components/HomeArt.astro';

const {
  title,
  description,
  eyebrow = 'TneXa',
  intro,
} = Astro.props.frontmatter;

const titleWords: string[] = title.split(' ');
---

<BaseLayout title={title} description={description}>
  <script is:inline>
    // Les effets de défilement ne s'activent qu'avec JavaScript et sans « réduire les animations ».
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('js-motion');
    }
  </script>

  <div class="home-progress" aria-hidden="true"></div>

  <header class="home-hero container">
    <div class="home-hero-text">
      <p class="eyebrow">{eyebrow}</p>
      <h1>
        {titleWords.map((word, i) => (
          <>
            <span class="hw"><span style={`--i:${i}`}>{word}</span></span>{' '}
          </>
        ))}
      </h1>
      {intro && <p class="home-intro">{intro}</p>}
    </div>
    <div class="home-hero-art" aria-hidden="true">
      <HomeArt name="orbit" />
    </div>
    <span class="home-cue" aria-hidden="true"></span>
  </header>

  <div class="home-flow">
    <slot />
  </div>

  <script>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Apparition des titres et des illustrations.
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('in');
            reveal.unobserve(entry.target);
          }
        },
        { threshold: 0.2, rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.home-text > h2, .home-art').forEach((el) => reveal.observe(el));

      // Lecture : les mots s'allument au fil du défilement.
      const splitWords = (block: HTMLElement): HTMLSpanElement[] => {
        const words: HTMLSpanElement[] = [];
        const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
        const nodes: Text[] = [];
        while (walker.nextNode()) nodes.push(walker.currentNode as Text);
        for (const node of nodes) {
          const fragment = document.createDocumentFragment();
          for (const part of (node.textContent ?? '').split(/(\s+)/)) {
            if (!part) continue;
            if (/^\s+$/.test(part)) {
              fragment.append(part);
              continue;
            }
            const span = document.createElement('span');
            span.className = 'w';
            span.textContent = part;
            words.push(span);
            fragment.append(span);
          }
          node.replaceWith(fragment);
        }
        return words;
      };

      const blocks = [...document.querySelectorAll<HTMLElement>('.home-lead p, .home-text p')].map((el) => ({
        el,
        words: splitWords(el),
        lit: 0,
      }));
      for (const block of blocks) block.el.setAttribute('data-ready', '');

      const update = () => {
        const vh = window.innerHeight;
        const atEnd = window.scrollY + vh >= document.documentElement.scrollHeight - 4;
        for (const block of blocks) {
          const rect = block.el.getBoundingClientRect();
          const progress = atEnd && rect.top < vh ? 1 : Math.min(1, Math.max(0, (vh * 0.9 - rect.top) / (vh * 0.2 + rect.height)));
          const lit = Math.round(progress * block.words.length);
          if (lit > block.lit) for (let i = block.lit; i < lit; i++) block.words[i].classList.add('on');
          else for (let i = lit; i < block.lit; i++) block.words[i].classList.remove('on');
          block.lit = lit;
          block.el.classList.toggle('done', progress >= 0.9);
        }
      };

      let queued = false;
      const schedule = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      update();
    }
  </script>
</BaseLayout>

<style>
  .home-progress {
    position: fixed;
    z-index: 60;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--mint), var(--lime));
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  .home-hero {
    position: relative;
    display: grid;
    gap: 2rem;
    align-content: center;
    min-height: calc(100svh - var(--header-h) - 1rem);
    padding-block: 1.5rem 4.5rem;
  }

  .home-hero-text {
    display: grid;
    justify-items: start;
  }

  .home-hero h1 {
    max-width: 14ch;
    margin-bottom: 1.5rem;
    font-size: clamp(2.2rem, 1.2rem + 5.6vw, 3.6rem);
    line-height: 1.04;
  }

  .hw {
    display: inline-block;
    margin-block: -0.06em;
    padding-block: 0.06em;
    overflow: hidden;
    vertical-align: top;
  }

  .hw > span {
    display: inline-block;
    transform: translateY(115%);
    animation: rise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 80ms + 150ms) forwards;
  }

  .home-intro {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    margin: 0;
    padding: 0.5rem 1.1rem 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--lime);
    font-weight: 750;
    letter-spacing: -0.01em;
    opacity: 0;
    animation: fade-up 800ms cubic-bezier(0.2, 0.7, 0.2, 1) 900ms forwards;
  }

  .home-intro::before {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ink);
    animation: pulse 2s ease-in-out infinite;
    content: '';
  }

  .home-hero-art {
    position: relative;
    width: min(100%, 22rem);
    aspect-ratio: 1;
    margin-inline: auto;
    animation: fade-up 1200ms cubic-bezier(0.2, 0.7, 0.2, 1) 300ms both;
  }

  .home-hero-art::before {
    position: absolute;
    z-index: -1;
    inset: -12%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 35%, rgba(223, 255, 99, 0.55), transparent 55%),
      radial-gradient(circle at 70% 70%, rgba(93, 224, 193, 0.4), transparent 55%);
    filter: blur(20px);
    content: '';
  }

  .home-cue {
    position: absolute;
    bottom: 1rem;
    left: 0;
    width: 2px;
    height: 3rem;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .home-cue::after {
    display: block;
    width: 100%;
    height: 40%;
    border-radius: 2px;
    background: var(--ink);
    animation: cue 1.8s cubic-bezier(0.6, 0, 0.3, 1) infinite;
    content: '';
  }

  @keyframes rise {
    to { transform: translateY(0); }
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(1.5rem); }
    to { opacity: 1; transform: none; }
  }

  @keyframes pulse {
    50% { transform: scale(1.6); opacity: 0.5; }
  }

  @keyframes cue {
    from { transform: translateY(-100%); }
    to { transform: translateY(250%); }
  }

  @keyframes grow {
    to { transform: scaleX(1); }
  }

  @keyframes drift {
    to { opacity: 0.15; transform: translateY(5rem) rotate(10deg) scale(0.9); }
  }

  @supports (animation-timeline: scroll()) {
    .home-progress {
      animation: grow linear both;
      animation-timeline: scroll(root block);
    }

    .home-hero-art {
      animation: fade-up 1200ms cubic-bezier(0.2, 0.7, 0.2, 1) 300ms both, drift linear both;
      animation-timeline: auto, view();
      animation-range: normal, exit 0% exit 100%;
    }
  }

  @media (min-width: 56rem) {
    .home-hero {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
    }

    .home-hero h1 {
      font-size: clamp(3rem, 1.6rem + 3.4vw, 4.8rem);
    }

    .home-hero-art {
      width: min(100%, 30rem);
    }
  }
</style>
