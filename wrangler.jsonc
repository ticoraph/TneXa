{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tnexa-site",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_TO": "contact@tnexa.fr",
    "CONTACT_FROM": "site@tnexa.fr"
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "contact@tnexa.fr"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
